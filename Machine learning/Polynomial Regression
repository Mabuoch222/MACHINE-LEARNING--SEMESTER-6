import numpy as np
import matplotlib.pyplot as plt

# -----------------------------
# Sample Historical Data
# (Replace with your real data)
# -----------------------------
years = np.array([
    1961,1962,1963,1964,1965,1966,1967,1968,1969,1970,
    1971,1972,1973,1974,1975,1976,1977,1978,1979,1980,
    1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,
    1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,
    2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,
    2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,
    2021,2022,2023,2024
])

yield_values = np.array([
    5900,5900,4700,5600,5600,5800,4100,5300,4800,4900,
    5700,6500,6400,5900,7400,7100,5200,5800,4100,5500,
    4600,3700,3000,3200,3200,3100,3000,2500,2700,3600,
    3200,3300,3700,4200,3100,4200,4200,4200,4200,4200,
    5000,6400,5100,5700,4900,5000,5400,6100,5600,5700,
    5900,6000,6100,6300,6000,6500,6600,6800,6700,6900,
    7100,7200,7100,7300
])

# -----------------------------
# Polynomial Trend Line
# -----------------------------
degree = 4
coeffs = np.polyfit(years, yield_values, degree)
poly = np.poly1d(coeffs)

years_smooth = np.linspace(years.min(), years.max(), 300)
trend = poly(years_smooth)

# -----------------------------
# Forecast (2026–2030)
# -----------------------------
forecast_years = np.array([2026, 2027, 2028, 2029, 2030])
forecast_values = poly(forecast_years) + np.array([200, 300, 400, 500, 600])  # slight growth boost

# -----------------------------
# Plot
# -----------------------------
plt.figure(figsize=(10,6))

# Scatter (Actual data)
plt.scatter(years, yield_values, label="Actual Yield")

# Trend line
plt.plot(years_smooth, trend, label="Polynomial Trend (Historical)")

# Forecast points
plt.scatter(forecast_years, forecast_values, label="Forecast (2026–2030)")

# Labels and styling
plt.title("Australia - Cherries")
plt.xlabel("Year")
plt.ylabel("Yield")
plt.legend()
plt.grid(True)

plt.show()
